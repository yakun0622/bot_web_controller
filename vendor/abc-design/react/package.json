{
  "name": "@abc-design/react",
  "version": "0.1.0",
  "description": "ABC Design — 零业务耦合的企业级 React 组件库、5 模态自适应布局框架与 Pro 业务套件",
  "type": "module",
  "main": "./dist/index.js",
