    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@abc-design/core": "file:../core",
    "@abc-design/tokens": "file:../tokens",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "lucide-react": "^1.59.0",
    "tailwind-merge": "^2.6.0"
